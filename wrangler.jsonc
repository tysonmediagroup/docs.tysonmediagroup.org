{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docs-tysonmediagroup-org",
  "main": "worker.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mytyson-db",
      "database_id": "a7a9072f-0921-4247-aebc-0c1c920a40a6"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "1054168096128-2er1dlrrkeqphr2bu8vpsa4v1rd99reg.apps.googleusercontent.com"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
